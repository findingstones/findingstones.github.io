---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

type Props = CollectionEntry<'blog'>['data'] & {
  headings?: Heading[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  headings = [],
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
    />
  </head>

  <body>
    <Header />

    <main class="article-shell">
      <article>
        <header class="article-header">
          <h1>{title}</h1>

          <p class="article-description">
            {description}
          </p>

          <div class="article-meta">
            <FormattedDate date={pubDate} />

            {
              updatedDate && (
                <span>
                  {' '}· Updated <FormattedDate date={updatedDate} />
                </span>
              )
            }
          </div>
        </header>

        {
          heroImage && (
            <Image
              class="article-hero"
              width={960}
              height={540}
              src={heroImage}
              alt=""
            />
          )
        }

        <TableOfContents headings={headings} />

        <div class="prose">
          <slot />
        </div>
      </article>
    </main>

    <Footer />

    <script is:inline>
      /*
       * Add a small "#" permalink beside every H2 and H3.
       * Astro has already generated the heading IDs.
       */
      document
        .querySelectorAll('.prose h2[id], .prose h3[id]')
        .forEach((heading) => {
          if (heading.querySelector('.heading-anchor')) return;

          const anchor = document.createElement('a');

          anchor.className = 'heading-anchor';
          anchor.href = `#${heading.id}`;
          anchor.setAttribute(
            'aria-label',
            `Link to ${heading.textContent || 'this section'}`
          );
          anchor.textContent = '#';

          heading.appendChild(anchor);
        });
    </script>
  </body>
</html>

<style>
  .article-shell {
    width: min(740px, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 5rem 0;
  }

  .article-header {
    margin-bottom: 3.5rem;
  }

  .article-header h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .article-description {
    max-width: 650px;
    margin: 0 0 1.25rem;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.55;
  }

  .article-meta {
    color: var(--muted);
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    font-size: 0.75rem;
  }

  .article-hero {
    width: 100%;
    margin: 0 0 3rem;
  }

  .prose {
    font-size: 1.04rem;
  }

  .prose :global(p) {
    margin: 0 0 1.5rem;
  }

  /*
   * scroll-margin prevents an anchored heading from sitting
   * directly against the top of the browser window.
   */
  .prose :global(h2),
  .prose :global(h3) {
    scroll-margin-top: 2rem;
  }

  .prose :global(h2) {
    margin: 3.5rem 0 1rem;
    font-size: 1.8rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .prose :global(h3) {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.3;
  }

  /*
   * HEADING PERMALINKS
   */

  .prose :global(.heading-anchor) {
    margin-left: 0.45rem;
    color: var(--muted);
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    font-size: 0.7em;
    font-weight: 400;
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .prose :global(h2:hover .heading-anchor),
  .prose :global(h3:hover .heading-anchor),
  .prose :global(.heading-anchor:focus) {
    opacity: 0.65;
  }

  .prose :global(.heading-anchor:hover) {
    opacity: 1;
  }

  /*
   * ORDINARY ARTICLE ELEMENTS
   */

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.45rem;
  }

  .prose :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--line);
    color: var(--muted);
    font-style: italic;
  }

  .prose :global(hr) {
    width: 30%;
    margin: 3.5rem auto;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .prose :global(code) {
    padding: 0.1em 0.3em;
    background: #f0eee8;
    border-radius: 3px;
    font-size: 0.88em;
  }

  .prose :global(pre) {
    overflow-x: auto;
    margin: 2rem 0;
    padding: 1rem;
    background: #f0eee8;
    border-radius: 4px;
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .prose :global(pre code) {
    padding: 0;
    background: transparent;
  }

  .prose :global(img) {
    display: block;
    margin: 2.5rem auto;
  }

  .prose :global(a) {
    overflow-wrap: anywhere;
  }

  /*
   * FOOTNOTE REFERENCES
   *
   * Example in text:
   * spaced repetition is useful.[^gwern]
   */

  .prose :global(a[data-footnote-ref]) {
    padding: 0 0.08em;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    font-size: 0.75em;
    font-weight: 600;
    text-decoration: none;
  }

  /*
   * FOOTNOTES SECTION GENERATED BY MARKDOWN
   */

  .prose :global([data-footnotes]) {
    margin-top: 4.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .prose :global([data-footnotes] h2) {
    margin: 0 0 1rem;
    color: var(--text);
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .prose :global([data-footnotes] ol) {
    padding-left: 1.4rem;
  }

  .prose :global([data-footnotes] li) {
    margin-bottom: 0.8rem;
  }

  .prose :global([data-footnote-backref]) {
    margin-left: 0.25rem;
    text-decoration: none;
  }

  @media (max-width: 650px) {
    .article-shell {
      width: min(100% - 2rem, 740px);
      padding-top: 3.5rem;
    }

    .article-header {
      margin-bottom: 2.5rem;
    }

    /*
     * On touchscreens there is no hover, so always show
     * the heading permalink.
     */
    .prose :global(.heading-anchor) {
      opacity: 0.5;
    }
  }
</style>