---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
    />
  </head>

  <body>
    <Header />

    <main class="article-shell">
      <article>
        <header class="article-header">
          <h1>{title}</h1>

          <p class="article-description">
            {description}
          </p>

          <div class="article-meta">
            <FormattedDate date={pubDate} />

            {
              updatedDate && (
                <span>
                  {' '}· Updated <FormattedDate date={updatedDate} />
                </span>
              )
            }
          </div>
        </header>

        {
          heroImage && (
            <Image
              class="article-hero"
              width={960}
              height={540}
              src={heroImage}
              alt=""
            />
          )
        }

        <div class="prose">
          <slot />
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  .article-shell {
    width: min(740px, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 5rem 0;
  }

  .article-header {
    margin-bottom: 3.5rem;
  }

  .article-header h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .article-description {
    max-width: 650px;
    margin: 0 0 1.25rem;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.55;
  }

  .article-meta {
    color: var(--muted);
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    font-size: 0.75rem;
  }

  .article-hero {
    width: 100%;
    margin: 0 0 3rem;
  }

  .prose {
    font-size: 1.04rem;
  }

  .prose :global(p) {
    margin: 0 0 1.5rem;
  }

  .prose :global(h2) {
    margin: 3.5rem 0 1rem;
    font-size: 1.8rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .prose :global(h3) {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.45rem;
  }

  .prose :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--line);
    color: var(--muted);
    font-style: italic;
  }

  .prose :global(hr) {
    width: 30%;
    margin: 3.5rem auto;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .prose :global(code) {
    padding: 0.1em 0.3em;
    background: #f0eee8;
    border-radius: 3px;
    font-size: 0.88em;
  }

  .prose :global(pre) {
    overflow-x: auto;
    margin: 2rem 0;
    padding: 1rem;
    background: #f0eee8;
    border-radius: 4px;
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .prose :global(pre code) {
    padding: 0;
    background: transparent;
  }

  .prose :global(img) {
    display: block;
    margin: 2.5rem auto;
  }

  .prose :global(a) {
    overflow-wrap: anywhere;
  }

  @media (max-width: 650px) {
    .article-shell {
      width: min(100% - 2rem, 740px);
      padding-top: 3.5rem;
    }

    .article-header {
      margin-bottom: 2.5rem;
    }
  }
</style>